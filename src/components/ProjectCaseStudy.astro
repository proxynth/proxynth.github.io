---
import LanguageSwitch from './LanguageSwitch.astro';
import Layout from '../layouts/Layout.astro';

interface Props {
  lang: 'en' | 'fr';
  project: 'payment-sandbox' | 'larawebhook';
}

const { lang, project } = Astro.props;
const pages = {
  'payment-sandbox': {
    en: {
      title: 'Payment Sandbox',
      description: 'A Go simulator for payment systems and distributed failures.',
      eyebrow: 'Open-source project · Go · Payments',
      lead: 'Testing a payment integration means more than checking HTTP status codes.',
      problemTitle: 'The problem',
      problem: 'A payment may succeed while the HTTP response is lost. A webhook may arrive twice, late or out of order. Two concurrent capture requests may race. These situations are difficult to reproduce with a traditional HTTP mock.',
      approachTitle: 'The approach',
      approach: 'Payment Sandbox models payment workflows and the asynchronous behaviours around them. Scenarios are deterministic, observable and reproducible, making it possible to test integrations without depending on a real provider.',
      scenarios: ['Lost responses and retries with idempotency keys', 'Delayed, duplicated, invalid or out-of-order webhooks', 'Concurrent capture and refund races', 'Temporarily inconsistent states and deterministic replay'],
      architectureTitle: 'Architecture choices',
      architecture: 'The project uses a modular monolith, domain-driven design and targeted hexagonal architecture. The goal is not to distribute the system artificially, but to isolate boundaries that provide real value: domain, persistence, clock, randomness, durable jobs and HTTP delivery.',
      statusTitle: 'Project status',
      status: 'The project is public and under active development. Public contracts and the scenario format are not stable yet, and the project is not presented as production-ready software.',
      source: 'View the source on GitHub ↗',
    },
    fr: {
      title: 'Payment Sandbox',
      description: 'Un simulateur en Go pour tester les systèmes de paiement et les défaillances distribuées.',
      eyebrow: 'Projet open source · Go · Paiements',
      lead: 'Tester une intégration de paiement ne se résume pas à vérifier les codes de statut HTTP.',
      problemTitle: 'Le problème',
      problem: 'Un paiement peut réussir alors que la réponse HTTP se perd. Un webhook peut arriver deux fois, en retard ou dans le désordre. Deux demandes de capture concurrentes peuvent entrer en conflit. Ces situations sont difficiles à reproduire avec un mock HTTP classique.',
      approachTitle: 'L’approche',
      approach: 'Payment Sandbox modélise les parcours de paiement et leurs comportements asynchrones. Les scénarios sont déterministes, observables et reproductibles, pour tester des intégrations sans dépendre d’un prestataire réel.',
      scenarios: ['Réponses perdues et nouvelles tentatives avec clés d’idempotence', 'Webhooks retardés, dupliqués, invalides ou reçus dans le désordre', 'Concurrence entre demandes de capture ou de remboursement', 'États temporairement incohérents et rejeu déterministe'],
      architectureTitle: 'Choix d’architecture',
      architecture: 'Le projet utilise un monolithe modulaire, une conception pilotée par le domaine (DDD) et une architecture hexagonale ciblée. L’objectif n’est pas de distribuer artificiellement le système, mais d’isoler les frontières utiles : domaine, persistance, horloge, aléatoire, tâches durables et transport HTTP.',
      statusTitle: 'État du projet',
      status: 'Le projet est public et en développement actif. Les contrats publics et le format des scénarios ne sont pas encore stabilisés ; le logiciel n’est pas présenté comme prêt pour la production.',
      source: 'Voir le code sur GitHub ↗',
    },
  },
  larawebhook: {
    en: {
      title: 'LaraWebhook',
      description: 'A Laravel package for reliable, idempotent and auditable webhooks.',
      eyebrow: 'Open-source project · PHP · Laravel',
      lead: 'A Laravel package for treating webhooks as messages that may be delayed, duplicated or replayed.',
      problemTitle: 'The problem',
      problem: 'Webhook integrations must handle signatures, retries, duplicates, transient failures and the need to investigate what actually happened.',
      approachTitle: 'What it provides',
      scenarios: ['Multi-service signature validation', 'Idempotency protected against concurrent races', 'Synchronous and asynchronous retries', 'Replay and an audit trail separated from deduplication', 'None, redacted or full payload storage', 'Dashboard, API, notifications and documentation'],
      architectureTitle: 'What the project demonstrates',
      architecture: 'The package was designed and implemented independently in approximately 80 hours, with unit, functional and architecture tests, PHPStan, Pint, Pest, CI and release automation.',
      statusTitle: 'Project status',
      status: 'It is a personal technical demonstration with no known external adoption.',
      source: 'View the GitHub repository ↗',
    },
    fr: {
      title: 'LaraWebhook',
      description: 'Un package Laravel pour recevoir et traiter des webhooks de façon fiable, idempotente et traçable.',
      eyebrow: 'Projet open source · PHP · Laravel',
      lead: 'Un package Laravel qui traite les webhooks comme des messages susceptibles d’arriver en retard, en double ou d’être rejoués.',
      problemTitle: 'Le problème',
      problem: 'Les intégrations par webhook doivent gérer les signatures, les nouvelles tentatives, les doublons, les erreurs temporaires et la nécessité de comprendre ce qui s’est réellement passé.',
      approachTitle: 'Fonctionnalités',
      scenarios: ['Validation des signatures de plusieurs services', 'Idempotence protégée contre les traitements concurrents', 'Nouvelles tentatives synchrones ou asynchrones', 'Rejeu et piste d’audit séparés de la déduplication', 'Stockage des payloads désactivé, expurgé ou complet', 'Tableau de bord, API, notifications et documentation'],
      architectureTitle: 'Ce que le projet démontre',
      architecture: 'Le package a été conçu et implémenté de façon indépendante en environ 80 heures, avec des tests unitaires, fonctionnels et d’architecture, PHPStan, Pint, Pest, une CI et l’automatisation des releases.',
      statusTitle: 'État du projet',
      status: 'Il s’agit d’une démonstration technique personnelle, sans adoption externe connue.',
      source: 'Voir le dépôt GitHub ↗',
    },
  },
};
const t = pages[project][lang];
const back = lang === 'fr' ? '← Retour au portfolio' : '← Back to the portfolio';
---

<Layout lang={lang} title={`${t.title} — Proxynth`} description={t.description}>
  <main class="case-study">
    <div class="case-header">
      <a class="back" href={lang === 'fr' ? '/fr/' : '/'}>{back}</a>
      <LanguageSwitch lang={lang} />
    </div>
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <section>
      <h2>{t.problemTitle}</h2>
      <p>{t.problem}</p>
    </section>
    <section>
      <h2>{t.approachTitle}</h2>
      {project === 'payment-sandbox' && <p>{t.approach}</p>}
      <ul>{t.scenarios.map((scenario) => <li>{scenario}</li>)}</ul>
    </section>
    <section>
      <h2>{t.architectureTitle}</h2>
      <p>{t.architecture}</p>
    </section>
    <section>
      <h2>{t.statusTitle}</h2>
      <p>{t.status}</p>
      <p class="public-note"><a class="button" href={project === 'payment-sandbox' ? 'https://github.com/proxynth/payment-sandbox' : 'https://github.com/proxynth/LaraWebhook'} target="_blank" rel="noreferrer">{t.source}</a></p>
    </section>
  </main>
</Layout>

<style>
  .case-study { max-width:760px; margin:auto; padding:48px 28px 100px; }
  .case-header { display:flex; justify-content:space-between; align-items:center; gap:18px; }
  .back { color:#9aa7b5; text-decoration:none; }
  .back:hover, .button:hover { color:#63e6be; }
  .eyebrow { margin-top:100px; color:#63e6be; text-transform:uppercase; letter-spacing:.13em; font-size:.72rem; font-weight:700; }
  h1 { font-size:clamp(3rem,8vw,6rem); line-height:.95; letter-spacing:-.07em; margin:20px 0; }
  .lead { color:#aeb8c4; font-size:1.35rem; line-height:1.5; }
  section { margin-top:70px; border-top:1px solid #26313c; padding-top:24px; }
  h2 { font-size:1.5rem; letter-spacing:-.03em; }
  p, li { color:#aeb8c4; line-height:1.75; }
  li { margin:8px 0; }
  .button { display:inline-block; margin-top:18px; padding:12px 16px; border:1px solid #315e50; border-radius:7px; color:#63e6be; text-decoration:none; }
  .public-note { margin-top:18px; }
  @media (max-width:560px) { .case-study { padding:32px 18px 80px; } .eyebrow { margin-top:76px; } }
</style>
